# ============================================================
# Konfigurasi root — dipakai oleh docker-compose.yml
# Salin menjadi .env lalu sesuaikan.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=fishpond
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=smartfishpond
POSTGRES_PORT=5432

# --- MQTT Broker (Mosquitto) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Broker menolak koneksi anonim. Password akun `fishpond-backend` (wajib)
# dan `fishpond-simulator` (development saja; kosongkan di produksi).
# Kredensial device ESP32 ada di docker/mosquitto/credentials.
# Buat password acak: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
MQTT_BACKEND_PASSWORD=ganti_password_backend
MQTT_SIMULATOR_PASSWORD=ganti_password_simulator

# --- Backend ---
BACKEND_PORT=4000
# Kunci penandatangan token login, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Notifikasi alert ke Telegram (opsional; lihat backend/.env.example)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
NOTIFY_MIN_SEVERITY=warning
# Token untuk scrape Prometheus di GET /metrics; kosong = endpoint nonaktif
METRICS_TOKEN=

# --- Frontend ---
FRONTEND_PORT=5173

# --- Produksi (docker-compose.prod.yml; lihat docs/operations.md) ---
# Domain dashboard; DNS harus mengarah ke server agar Caddy bisa memasang HTTPS.
DOMAIN=
# Backup database otomatis (layanan db-backup)
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
