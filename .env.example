# --- PostgreSQL ---
POSTGRES_USER=fishpond
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=smartfishpond
POSTGRES_PORT=5432

# --- MQTT Broker (Mosquitto) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Backend ---
BACKEND_PORT=4000

# --- Frontend ---
FRONTEND_PORT=5173
