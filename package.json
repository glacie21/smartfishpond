{
  "name": "smartfishpond-iot",
  "version": "0.1.0",
  "description": "Sistem monitoring kualitas air kolam ikan berbasis IoT (ESP32 + MQTT + Node.js + React)",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "user:create": "npm run user:create --workspace backend --",
    "seed": "node scripts/seed.js",
    "simulate": "node scripts/simulate-device.js",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "test:integration": "npm run test:integration --workspace backend",
    "backup": "sh scripts/backup-db.sh",
    "restore": "sh scripts/restore-db.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
