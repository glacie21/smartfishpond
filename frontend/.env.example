# ============================================================
#  Frontend — salin menjadi .env
#  Semua variabel wajib berawalan VITE_ agar terbaca Vite.
# ============================================================

# Kosongkan saat development (memakai proxy di vite.config.js).
# Isi dengan URL backend saat build produksi, mis. https://api.contoh.com
VITE_API_BASE_URL=
VITE_SOCKET_URL=
