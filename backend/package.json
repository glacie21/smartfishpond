{
  "name": "smartfishpond-backend",
  "version": "0.1.0",
  "description": "REST API + MQTT ingest untuk Smart Fish Pond IoT",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
