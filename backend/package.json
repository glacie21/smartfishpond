    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mqtt": "^5.5.0",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "vitest": "^1.5.0"
  },
  "license": "MIT"
}
