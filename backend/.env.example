# ============================================================
#  Backend — salin menjadi .env
# ============================================================

NODE_ENV=development
PORT=4000

# --- PostgreSQL ---
DATABASE_URL=postgres://fishpond:ganti_password_ini@localhost:5432/smartfishpond
PG_POOL_MAX=10

# --- Autentikasi dashboard ---
# Wajib di produksi (min. 32 karakter). Kosong saat development = secret
# bawaan yang tidak aman. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Masa berlaku token login (format: 30m, 12h, 7d)
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# --- Rate limit (per IP) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Percobaan login GAGAL per jendela waktu
LOGIN_RATE_LIMIT_MAX=10
# Isi jumlah hop bila backend di belakang reverse proxy (mis. 1 untuk nginx)
TRUST_PROXY=false

# --- MQTT Broker ---
MQTT_URL=mqtt://localhost:1883
# Sama dengan MQTT_BACKEND_PASSWORD di .env root
MQTT_USERNAME=fishpond-backend
MQTT_PASSWORD=
# Broker memakai username sebagai client ID; nilai ini hanya berlaku
# bila broker tidak memaksa use_username_as_clientid.
MQTT_CLIENT_ID=fishpond-backend
# Topik yang di-subscribe: fishpond/<pondId>/<deviceId>/<telemetry|status>
MQTT_TOPIC_TELEMETRY=fishpond/+/+/telemetry
MQTT_TOPIC_STATUS=fishpond/+/+/status
MQTT_TOPIC_ACTUATORS=fishpond/+/+/actuators
MQTT_TOPIC_ACK=fishpond/+/+/ack

# --- CORS: origin frontend yang diizinkan (pisahkan dengan koma) ---
CORS_ORIGIN=http://localhost:5173

# --- Retensi (hari); 0 = tidak dihapus otomatis ---
# Data mentah (tiap 30 detik) — dipakai grafik rentang pendek
RAW_RETENTION_DAYS=90
# Rollup per jam — dipakai grafik 7/30 hari & riwayat panjang
HOURLY_RETENTION_DAYS=730

# --- Alert ---
# Pembacaan berturut-turut di luar batas sebelum alert dibuka (redam noise sensor)
ALERT_CONFIRM_READINGS=2
# Device offline lebih lama dari ini (detik) baru dibuatkan alert
ALERT_OFFLINE_DELAY_SECONDS=300

# --- Notifikasi Telegram (kosongkan untuk menonaktifkan) ---
# Buat bot lewat @BotFather; chat id didapat dari
# https://api.telegram.org/bot<TOKEN>/getUpdates setelah mengirim pesan ke bot.
TELEGRAM_BOT_TOKEN=
# Beberapa penerima dipisah koma (user, grup, atau channel)
TELEGRAM_CHAT_IDS=
# warning = semua alert, critical = hanya yang kritis
NOTIFY_MIN_SEVERITY=warning

# --- Kontrol aktuator ---
# Perintah tanpa balasan device setelah sekian detik ditandai timeout
COMMAND_ACK_TIMEOUT_SECONDS=30
