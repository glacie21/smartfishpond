# ============================================================
#  Backend — salin menjadi .env
# ============================================================

NODE_ENV=development
PORT=4000

# --- PostgreSQL ---
DATABASE_URL=postgres://fishpond:ganti_password_ini@localhost:5432/smartfishpond
PG_POOL_MAX=10

# --- MQTT Broker ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fishpond-backend
# Topik yang di-subscribe: fishpond/<pondId>/<deviceId>/<telemetry|status>
MQTT_TOPIC_TELEMETRY=fishpond/+/+/telemetry
MQTT_TOPIC_STATUS=fishpond/+/+/status

# --- CORS: origin frontend yang diizinkan (pisahkan dengan koma) ---
CORS_ORIGIN=http://localhost:5173

# --- Retensi data mentah (hari); 0 = tidak dihapus otomatis ---
RAW_RETENTION_DAYS=90
